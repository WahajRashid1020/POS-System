# MongoDB
MONGODB_URI=xyz

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini (aistudio.google.com) — used by the AI chat
GEMINI_API_KEY=your-gemini-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
# From `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# Passwordless demo accounts (anyone can pick any role, including admin).
# Leave unset/false in production. Set to true only for local development or a
# throwaway demo deployment that uses a test database and Stripe test keys.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
